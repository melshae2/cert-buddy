{
  "manifest_version": 3,
  "name": "Cert Buddy",
  "version": "0.10.5",
  "description": "Tag the practice questions you miss, right where you study. Local-only weak-area tracking for cert prep.",
  "permissions": ["storage", "scripting", "activeTab"],
  "action": {
    "default_title": "Cert Buddy",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.udemy.com/*"],
      "js": [
        "src/lib/store.js",
        "src/lib/taxonomy.js",
        "src/content/adapters.js",
        "src/content/outcomes.js",
        "src/content/tagger.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
